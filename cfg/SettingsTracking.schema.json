{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "3D Tracking Configuration Schema",
  "type": "object",
  "properties": {
    "cfg_multicamera": {
      "type": "string",
      "description": "Path to multicamera configuration file"
    },
    "cfg_camera_calibration": {
      "type": "string",
      "description": "Path to multicamera configuration file"
    },
    "cfg_det": {
      "type": "string",
      "description": "Path to detection model configuration file"
    },
    "cfg_pose": {
      "type": "string",
      "description": "Path to pose estimation model configuration file"
    },
    "online_mode": {
      "type": "boolean",
      "description": "Run in online/live mode"
    },
    "maf_window_size": {
      "type": "integer",
      "description": "Number of steps in the past for a state to be used in the MA update"
    },
    "filter_conf_threshold": {
      "type": "number",
      "description": "Confidence threshold for the filter stage"
    }
  },
  "required": [
    "cfg_multicamera",
    "cfg_camera_calibration",
    "cfg_det",
    "cfg_pose",
    "online_mode",
    "maf_window_size",
    "filter_conf_threshold"
  ],
  "additionalProperties": false
}
