{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "lower": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Lower HSV threshold values [H, S, V]."
      },
      "upper": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "minItems": 3,
        "maxItems": 3,
        "description": "Upper HSV threshold values [H, S, V]."
      }
    },
    "required": ["lower", "upper"],
    "additionalProperties": false
}